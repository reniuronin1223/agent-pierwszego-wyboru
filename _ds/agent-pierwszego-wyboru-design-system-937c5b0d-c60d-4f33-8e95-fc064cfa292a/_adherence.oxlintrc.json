{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Mulish))/i]",
        "message": "Font not provided by the design system. Available: Mulish."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|title|tone|style|key|ref|className|style|children)$/]",
        "message": "<ArrowList> doesn't accept that prop. Declared props: items, title, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowList'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|onDark)$/]",
        "message": "<ArrowList> tone must be one of 'dark' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|children|disabled|iconRight|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, children, disabled, iconRight, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dark|primary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'dark' | 'primary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|pad|radius|hoverable|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, pad, radius, hoverable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|muted|dark|brand)$/]",
        "message": "<Card> tone must be one of 'light' | 'muted' | 'dark' | 'brand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> pad must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:card|panel|sm)$/]",
        "message": "<Card> radius must be one of 'card' | 'panel' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClaimBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:primary|secondary|style|key|ref|className|style|children)$/]",
        "message": "<ClaimBanner> doesn't accept that prop. Declared props: primary, secondary, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CriteriaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|key|ref|className|style|children)$/]",
        "message": "<CriteriaItem> doesn't accept that prop. Declared props: icon, title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='EyebrowLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|tilt|style|key|ref|className|style|children)$/]",
        "message": "<EyebrowLabel> doesn't accept that prop. Declared props: children, tone, tilt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EyebrowLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|dark)$/]",
        "message": "<EyebrowLabel> tone must be one of 'yellow' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|icon|iconAlt|tone|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: title, body, icon, iconAlt, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<FeatureCard> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|size|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<IconChip> doesn't accept that prop. Declared props: src, alt, size, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconChip> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|dark|tint)$/]",
        "message": "<IconChip> tone must be one of 'yellow' | 'dark' | 'tint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|label|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<LogoTab> doesn't accept that prop. Declared props: logo, label, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|items|active|onSelect|action|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: brand, items, active, onSelect, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|title|body|tilt|style|key|ref|className|style|children)$/]",
        "message": "<ProcessStep> doesn't accept that prop. Declared props: step, title, body, tilt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|role|avatar|align|style|key|ref|className|style|children)$/]",
        "message": "<QuoteCard> doesn't accept that prop. Declared props: quote, author, role, avatar, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<QuoteCard> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReelCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:thumbnail|title|handle|role|duration|onPlay|style|key|ref|className|style|children)$/]",
        "message": "<ReelCard> doesn't accept that prop. Declared props: thumbnail, title, handle, role, duration, onPlay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|eyebrow|align|size|as|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: children, eyebrow, align, size, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|h1|h2|h3)$/]",
        "message": "<SectionHeading> size must be one of 'hero' | 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3)$/]",
        "message": "<SectionHeading> as must be one of 'h1' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: count, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|yellow)$/]",
        "message": "<StarRating> tone must be one of 'dark' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|label|sublabel|icon|iconAlt|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: value, unit, label, sublabel, icon, iconAlt, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
